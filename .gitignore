# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

public/backgrounds
/scripts/*
!/scripts/vendor-static-assets.ts
!/scripts/hoist-default-locale.ts

# Full weights are assembled from vendor/models/**/*.onnx.part-*
# This fork cannot store Git LFS objects, and GitHub rejects files over 100 MB.
/vendor/models/**/*.onnx

# Regenerated by scripts/vendor-static-assets.ts
/public/ffmpeg/core
/public/ffmpeg/core-mt
/public/onnx
/public/models
/public/media
/public/fonts/code
/public/llms.txt
/public/llms-full.txt
/public/openapi.json

prisma/migrations
/lib/generated/prisma
# Prisma
prisma/*.db
prisma/*.db-journal

#files
moving-forward.md